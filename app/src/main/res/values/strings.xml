    <string name="detail_remove_driver_title">Remove driver?</string>
    <string name="detail_remove_driver_text">This ends monitoring for %1$s. If there is a second admin, they are removed too. The driver needs a new code to pair again.</string>
    <string name="detail_remove_second_title">Remove second admin?</string>
    <string name="detail_remove_second_text">%1$s will stop seeing this driver.</string>
    <string name="detail_leave_title">Leave this driver?</string>
