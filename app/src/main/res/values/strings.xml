    <!-- Sign-in -->
    <string name="sign_in_subtitle">Speed alerts for employers and their drivers</string>
    <string name="sign_in_body">Sign in with the Google account you want to use for this app.</string>
    <string name="sign_in_policy">For employers monitoring their own employed drivers only. Drivers see and agree to the monitoring in the app. All users must be 18 or older.</string>
    <string name="error_no_google_account">No Google account found on this phone. Add one in Settings &gt; Accounts and try again.</string>
    <string name="error_sign_in_failed">Sign-in failed: %1$s</string>

    <!-- Role selection -->
    <string name="role_title">Who are you?</string>
    <string name="role_hello">Hello, %1$s</string>
    <string name="role_admin_title">Admin</string>
    <string name="role_admin_body">I own or manage vehicles and want to monitor my employed drivers.</string>
    <string name="role_driver_title">Driver</string>
    <string name="role_driver_body">I drive for an employer who uses this app.</string>
    <string name="role_note">You can change this later as long as you are not linked to anyone.</string>
    <string name="change_role_title">Change role?</string>
    <string name="change_role_text">You will switch to %1$s. This works only while you are not linked to anyone.</string>

    <!-- Driver home -->
    <string name="driver_title">Driver</string>
    <string name="driver_unlinked_title">Not linked yet</string>
    <string name="driver_unlinked_body">Ask your admin to open the app, tap Add driver, and send you the 6-digit code on WhatsApp or by phone.</string>
    <string name="code_label">6-digit code</string>
    <string name="driver_join_button">Join</string>
    <string name="driver_who_can_see">Who can see my data</string>

