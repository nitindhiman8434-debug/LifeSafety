    <string name="trip_end">End Trip</string>
    <string name="trip_auto_end_note">Trip ends automatically when you park for %1$d minutes.</string>
    <string name="trip_simulate">Simulate drive (test mode)</string>
    <string name="trip_simulating_note">Fake speeds are being used. Turn this off before a real drive.</string>
    <string name="trip_end_test">End trip (test mode)</string>

    <!-- Permissions (explained before asking, as Google Play requires) -->
    <string name="perm_location_title">Location permission needed</string>
    <string name="perm_location_body">Driver Safety Monitor uses your precise location only during trips, to measure speed and show your admins where the vehicle is. Nothing is tracked outside trips.</string>
    <string name="perm_notifications_title">Notifications needed</string>
    <string name="perm_notifications_body">Android shows a notification while a trip is running and while monitoring is active, so you always know. Please allow it.</string>
    <string name="perm_allow">Allow</string>
    <string name="perm_open_settings">Open settings</string>
    <string name="perm_denied_note">Permission was denied. Open settings and allow Location (precise) and Notifications for this app.</string>

    <!-- Notifications -->
    <string name="notif_channel_monitoring">Monitoring status</string>
    <string name="notif_channel_trip">Active trip</string>
    <string name="notif_monitoring_title">Monitoring active</string>
    <string name="notif_monitoring_text">%1$s can see your trips.</string>
    <string name="notif_trip_title">Trip in progress</string>
    <string name="notif_trip_text">%1$s km/h · limit %2$d</string>
    <string name="notif_trip_slow_down">Over the speed limit. Slow down.</string>
    <string name="notif_trip_no_gps">Waiting for GPS…</string>

    <!-- Alarm voice. The locale picks the text-to-speech voice; the fallback is spoken when that voice is missing. -->
    <string name="alarm_voice">Please slow down</string>
    <string name="alarm_voice_locale">en-IN</string>
    <string name="alarm_voice_fallback" translatable="false">Please slow down</string>

    <!-- Consent screen -->
    <string name="consent_top_title">Your approval</string>
    <string name="consent_title">Allow %1$s to monitor your driving?</string>
    <string name="consent_role_primary">%1$s will be your primary admin.</string>
    <string name="consent_role_secondary">%1$s will be your second admin.</string>
    <string name="consent_sees_title">They will be able to see</string>
    <string name="consent_sees_1">Your live location and speed during trips</string>
    <string name="consent_sees_2">The battery level of your phone and whether tracking is working</string>
    <string name="consent_sees_3">Your trip history: date, duration, distance and top speed</string>
    <string name="consent_sees_4">Alerts, for example when you go over the speed limit or press SOS</string>
    <string name="consent_when_title">When</string>
    <string name="consent_when_body">Only during trips that you start, or that an admin asks you to start. Outside trips the app sends a short status check (battery, tracking working) every 30 minutes, without location.</string>
    <string name="consent_not_title">Never</string>
    <string name="consent_not_body">Your calls, messages, other apps, or your location outside trips.</string>
    <string name="consent_remove_note">You can remove this admin at any time from \"Who can see my data\".</string>

    <!-- Who can see my data -->
    <string name="admins_title">Who can see my data</string>
    <string name="admins_primary_label">Primary admin</string>
    <string name="admins_secondary_label">Second admin</string>
    <string name="admins_secondary_none">Second admin: not added</string>
    <string name="admins_sees">Sees your live location and speed during trips, battery, trip history and alerts.</string>
    <string name="admins_remove_primary_title">Remove primary admin?</string>
    <string name="admins_remove_primary_text">%1$s will stop seeing your data. This ends the whole link; if you have a second admin, they are removed too. You will need a new code to pair again.</string>
    <string name="admins_remove_secondary_title">Remove second admin?</string>
    <string name="admins_remove_secondary_text">%1$s will stop seeing your data. Your primary admin stays.</string>
    <string name="admins_none">No admin is linked.</string>

    <!-- Admin dashboard -->
    <string name="admin_title">Admin</string>
    <string name="admin_add_driver">Add driver</string>
    <string name="admin_join_second">Join as second admin</string>
    <string name="admin_no_drivers_title">No drivers yet</string>
    <string name="admin_no_drivers_body">Tap Add driver to get a 6-digit code and send it to your driver. Or tap Join as second admin if a primary admin gave you a code.</string>
    <string name="admin_role_primary">You: Primary admin</string>
    <string name="admin_role_secondary">You: Second admin</string>
    <string name="link_status_pending">Waiting for driver consent</string>
    <string name="link_status_active">Active</string>

    <!-- Pairing code screen -->
    <string name="code_title_primary">Code for your driver</string>
    <string name="code_title_secondary">Code for the second admin</string>
    <string name="code_body_primary">Send this code to your driver on WhatsApp or by phone. They install the app, choose Driver, sign in with Google and enter it.</string>
    <string name="code_body_secondary">Send this code to the person who will be the second admin. They install the app, choose Admin, and tap Join as second admin. Your driver then has to agree in their app.</string>
    <string name="code_valid_for">Valid for %1$s</string>
    <string name="code_expired">Code expired. Tap New code.</string>
    <string name="code_share_text_primary">Driver Safety Monitor code: %1$s\nInstall the app, choose Driver, sign in with Google and enter this code. It is valid for 10 minutes.</string>
    <string name="code_share_text_secondary">Driver Safety Monitor second-admin code: %1$s\nInstall the app, choose Admin, tap Join as second admin and enter this code. It is valid for 10 minutes.</string>

    <!-- Join as second admin -->
    <string name="join_title">Join as second admin</string>
    <string name="join_body">Enter the 6-digit code the primary admin gave you. The driver has to agree before you see anything.</string>

