    <string name="trip_admins">Admins: %1$s</string>
    <string name="trip_gps_idle">GPS: off until a trip starts</string>
    <string name="trip_gps_searching">GPS: searching…</string>
    <string name="trip_gps_ok">GPS: good</string>
    <string name="trip_gps_off">GPS: no permission</string>
    <string name="trip_last_sync">Last sync %1$s</string>
    <string name="trip_last_sync_never">Not synced yet</string>
    <string name="trip_pending">%1$d items waiting to upload</string>
    <string name="trip_speed_no_fix">--</string>
    <string name="trip_speed_unit">km/h</string>
    <string name="trip_limit_badge">LIMIT %1$d</string>
    <string name="trip_slow_down">SLOW DOWN</string>
