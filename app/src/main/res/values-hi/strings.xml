    <string name="role_admin_title">एडमिन</string>
    <string name="role_admin_body">मेरे पास गाड़ियाँ हैं या मैं उन्हें संभालता/संभालती हूँ, और अपने नौकरी पर रखे ड्राइवरों की निगरानी करना चाहता/चाहती हूँ।</string>
    <string name="role_driver_title">ड्राइवर</string>
    <string name="role_driver_body">मैं ऐसे मालिक के लिए गाड़ी चलाता/चलाती हूँ जो यह ऐप इस्तेमाल करता है।</string>
    <string name="role_note">जब तक आप किसी से जुड़े नहीं हैं, आप इसे बाद में बदल सकते हैं।</string>
    <string name="change_role_title">भूमिका बदलें?</string>
    <string name="change_role_text">आप %1$s बन जाएँगे। यह तभी होता है जब आप किसी से जुड़े न हों।</string>

