    <!-- Permissions -->
    <string name="perm_location_title">लोकेशन की अनुमति चाहिए</string>
    <string name="perm_location_body">ड्राइवर सेफ़्टी मॉनिटर आपकी सटीक लोकेशन सिर्फ़ ट्रिप के दौरान इस्तेमाल करता है, स्पीड नापने और एडमिन को गाड़ी की जगह दिखाने के लिए। ट्रिप के बाहर कुछ भी ट्रैक नहीं होता।</string>
    <string name="perm_notifications_title">नोटिफ़िकेशन की अनुमति चाहिए</string>
    <string name="perm_notifications_body">ट्रिप चलते समय और निगरानी चालू रहते समय Android एक नोटिफ़िकेशन दिखाता है, ताकि आपको हमेशा पता रहे। कृपया अनुमति दें।</string>
