    <string name="sign_in_body">उस Google खाते से साइन इन करें जिसे आप इस ऐप के लिए इस्तेमाल करना चाहते हैं।</string>
    <string name="sign_in_policy">यह ऐप सिर्फ़ उन मालिकों और कंपनियों के लिए है जो अपने नौकरी पर रखे ड्राइवरों की निगरानी करते हैं। ड्राइवर ऐप में निगरानी की जानकारी देखकर उसे मंज़ूरी देते हैं। सभी उपयोगकर्ता 18 साल या उससे बड़े होने चाहिए।</string>
    <string name="error_no_google_account">इस फ़ोन पर कोई Google खाता नहीं मिला। फ़ोन की Settings (सेटिंग) &gt; Accounts (खाते) में खाता जोड़ें और फिर कोशिश करें।</string>
    <string name="error_sign_in_failed">साइन इन नहीं हो सका: %1$s</string>

    <!-- Role selection -->
