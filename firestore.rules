rules_version = '2';

// Deny by default. Every rule below opens exactly one door.
// All writes to links, drivers, pairing codes and roles go through Cloud Functions (functions/src/index.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A user's own profile, role and push tokens. Written only by Cloud Functions (setRole, registerFcmToken).
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      // The admin's alert inbox, filled by Cloud Functions. The admin may only mark an alert as read.
      match /alerts/{alertId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // One doc per driver-admin pair. Both sides may read it, so each sees the link status and the other's role.
    match /links/{linkId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.driverId || request.auth.uid == resource.data.adminId);
      allow write: if false;
    }

    // True for admins the driver has approved (they are listed in drivers/{driverId}.adminIds).
    function isActiveAdmin(driverId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/drivers/$(driverId)).data.adminIds;
    }

    // The driver's phone may update "live" (speed, position, battery, trip status) and may clear "command"
    // once it has obeyed it (end trip now). Everything else (settings, phone, link fields) is written by
    // Cloud Functions, including the primary admin's settings through updateDriverSettings.
    function driverPhoneUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['live', 'updatedAt', 'command'])
        && (!('command' in keys) || !('command' in request.resource.data));
    }

    // The driver's record, settings and live block. Readable by the driver and by admins the driver has approved (adminIds).
    match /drivers/{driverId} {
      allow read: if isSelf(driverId)
        || (signedIn() && request.auth.uid in resource.data.adminIds);
      allow update: if isSelf(driverId) && driverPhoneUpdate();
      allow create, delete: if false;

      // Trip summaries, written by the driver's phone. Approved admins read them.
      match /trips/{tripId} {
        allow read: if isSelf(driverId) || isActiveAdmin(driverId);
        allow create, update: if isSelf(driverId) && request.resource.data.driverId == driverId;
        allow delete: if false;

        // Batches of GPS points (about one document every 10 seconds during a trip).
        // A batch sent again after a timed-out upload may have grown meanwhile: same batch, never fewer points.
        match /points/{batchId} {
          allow read: if isSelf(driverId) || isActiveAdmin(driverId);
          allow create: if isSelf(driverId)
            && request.resource.data.driverId == driverId
            && request.resource.data.tripId == tripId;
          allow update: if isSelf(driverId)
            && request.resource.data.driverId == driverId
            && request.resource.data.tripId == tripId
            && request.resource.data.firstAtUtc == resource.data.firstAtUtc
            && request.resource.data.count >= resource.data.count;
          allow delete: if false;
        }
      }

      // Overspeed and other events, written by the driver's phone.
      // An event sent again after a timed-out upload may only change its upload bookkeeping.
      match /events/{eventId} {
        allow read: if isSelf(driverId) || isActiveAdmin(driverId);
        allow create: if isSelf(driverId) && request.resource.data.driverId == driverId;
        allow update: if isSelf(driverId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delayed', 'uploadedAt']);
        allow delete: if false;
      }
    }

    // Hashed pairing codes and rate-limit counters: Cloud Functions only.
    match /pairingCodes/{codeId} {
      allow read, write: if false;
    }

    match /codeAttempts/{uid} {
      allow read, write: if false;
    }
  }
}
